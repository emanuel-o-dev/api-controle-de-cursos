# Example environment variables for local development
# Copie este arquivo para `.env` e preencha os valores lá. NÃO commit segredos reais.

# Database connection used by Prisma
# Format example: postgres://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:password@localhost:5432/dbname


# Substitua por uma chave segura em produção
JWT_SECRET=troque_por_uma_chave_secreta_segura

# Application port
PORT=3000

# Notes:
# - Prisma will read DATABASE_URL from the environment when running migrations.
# - Keep production secrets outside the repository (use your cloud provider secrets manager).
